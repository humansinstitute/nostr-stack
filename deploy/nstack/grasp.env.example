# Public configuration only. Service-generated identity stays in the data volume.
GRASP_IMAGE=registry.example/nstack-grasp@sha256:replace-with-tested-image-digest
GRASP_DATA_VOLUME=tower-grasp-poc-data
GRASP_HOST_PORT=60546
GRASP_DOMAIN=replace-with-canonical-npub.fips:port
GRASP_PUBLIC_ORIGIN=http://replace-with-canonical-npub.fips:port
GRASP_PRIVATE_MEMBERS=
GRASP_MAINTAINERS=

# Requires the tested repository-ACL build, not the earlier unpatched image.
GRASP_READERS_FILE=./tmp/docs/handoffs/grasp-migration/repository-readers.json
