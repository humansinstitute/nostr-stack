+    /// Load an explicit fail-closed repository read manifest. It only narrows
+    /// service membership; it never confers canonical write/maintainer authority.
+    pub fn load_repository_readers(&self, path: &std::path::Path) -> anyhow::Result<()> {
+        let bytes = std::fs::read(path)?;
+        let raw: HashMap<String, Vec<String>> = serde_json::from_slice(&bytes)?;
+        anyhow::ensure!(!raw.is_empty(), "Repository read manifest is empty");
+        let mut readers = HashMap::new();
+        for (coordinate, members) in raw {
+            let (owner, identifier) = coordinate
+                .split_once('/')
+                .ok_or_else(|| anyhow::anyhow!("Invalid repository coordinate"))?;
+            let owner_key = PublicKey::parse(owner)?;
+            anyhow::ensure!(
+                owner_key.to_bech32()? == owner
+                    && !identifier.is_empty()
+                    && !identifier.contains('/')
+                    && !members.is_empty(),
+                "Invalid repository read manifest entry"
+            );
+            let keys: HashSet<PublicKey> = members
+                .iter()
+                .map(|value| PublicKey::parse(value))
+                .collect::<Result<_, _>>()?;
+            anyhow::ensure!(
+                keys.contains(&owner_key),
+                "Repository owner must remain a reader"
+            );
+            readers.insert(coordinate, keys);
+        }
+        *self
+            .inner
+            .repository_readers
+            .write()
+            .expect("repository access lock poisoned") = Some(readers);
+        Ok(())
+    }
+
+    pub fn repository_scoped(&self) -> bool {
+        self.inner
+            .repository_readers
+            .read()
+            .expect("repository access lock poisoned")
+            .is_some()
+    }
+
+    pub fn can_read_repository(
+        &self,
+        reader: &PublicKey,
+        owner: &PublicKey,
+        identifier: &str,
+    ) -> bool {
+        if !self.contains(reader) {
+            return false;
+        }
+        let manifest = self
+            .inner
+            .repository_readers
+            .read()
+            .expect("repository access lock poisoned");
+        let Some(manifest) = manifest.as_ref() else {
+            return true;
+        };
+        let owner = owner
+            .to_bech32()
+            .expect("public-key encoding is infallible");
+        manifest
+            .get(&format!("{owner}/{identifier}"))
+            .is_some_and(|members| members.contains(reader))
+    }
+
+    pub fn can_read_url(&self, reader: &PublicKey, url: &str) -> bool {
+        if !self.repository_scoped() {
+            return self.contains(reader);
+        }
+        let Some((_, path)) = url
+            .split_once("://")
+            .and_then(|(_, rest)| rest.split_once('/'))
+        else {
+            return false;
+        };
+        let Some((owner, repository)) = path.split_once('/') else {
+            return false;
+        };
+        let Some(identifier) = repository.strip_suffix(".git") else {
+            return false;
+        };
+        let Ok(owner) = PublicKey::parse(owner) else {
+            return false;
+        };
+        self.can_read_repository(reader, &owner, identifier)
+    }
+
+    /// Do not leak repository events through broad subscriptions or e-only
+    /// replies. Scoped private clients must carry their repository a/A tag.
+    pub fn can_read_event(&self, reader: &PublicKey, event: &Event) -> bool {
+        if !self.repository_scoped() {
+            return self.contains(reader);
+        }
+        let kind = event.kind.as_u16();
+        if kind == 30617 || kind == 30618 {
+            let identifiers: Vec<_> = event
+                .tags
+                .iter()
+                .filter_map(|t| {
+                    let v = t.as_slice();
+                    (v.len() == 2 && v[0] == "d").then(|| v[1].clone())
+                })
+                .collect();
+            return identifiers.len() == 1
+                && self.can_read_repository(reader, &event.pubkey, &identifiers[0]);
+        }
+        let mut coordinates = 0;
+        for tag in event.tags.iter() {
+            let values = tag.as_slice();
+            if values.len() < 2 || (values[0] != "a" && values[0] != "A") {
+                continue;
+            }
+            let mut parts = values[1].splitn(3, ':');
+            if parts.next() != Some("30617") {
+                return false;
+            }
+            let Some(owner) = parts.next().and_then(|v| PublicKey::parse(v).ok()) else {
+                return false;
+            };
+            let Some(identifier) = parts.next() else {
+                return false;
+            };
+            if !self.can_read_repository(reader, &owner, identifier) {
+                return false;
+            }
+            coordinates += 1;
+        }
+        coordinates > 0
+    }
