--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,21 @@
+FROM node:22.23.4-trixie AS build
+
+WORKDIR /app
+RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
+COPY package.json pnpm-lock.yaml ./
+RUN pnpm install --frozen-lockfile
+COPY . .
+ARG GIT_COMMIT=unknown
+ARG GIT_COMMIT_DATE=unknown
+ENV APP_GIT_COMMIT=${GIT_COMMIT}
+ENV APP_GIT_COMMIT_DATE=${GIT_COMMIT_DATE}
+RUN pnpm build
+
+FROM node:22.23.4-trixie
+WORKDIR /app
+ENV NODE_ENV=production PORT=8080
+COPY --from=build /app/dist ./dist
+COPY scripts/serve-dist.mjs ./scripts/serve-dist.mjs
+USER node
+EXPOSE 8080
+CMD ["node", "scripts/serve-dist.mjs"]
