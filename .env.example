PORT=3100
SUPERBASED_DIRECT_HTTPS_URL=http://127.0.0.1:3100
SUPERBASED_TOWER_NAME=
SUPERBASED_TOWER_DESCRIPTION=
NSTACK_DESCRIPTOR_CACHE_TTL_SECONDS=30
# Native source tests keep sidecars disabled. Enable only with explicit root origins.
# Optional root HTTPS Autopilot origin for authenticated agent discovery.
# Empty means no advertised Autopilot service; never infer an origin.
NSTACK_AUTOPILOT_PUBLIC_ORIGIN=
NSTACK_RELAY_ENABLED=false
NSTACK_RELAY_PUBLIC_ORIGIN=
NSTACK_RELAY_HEALTH_URL=
NSTACK_BLOSSOM_ENABLED=false
NSTACK_BLOSSOM_PUBLIC_ORIGIN=
NSTACK_BLOSSOM_HEALTH_URL=
SUPERBASED_BILLING_MODE=disabled
SUPERBASED_BILLING_GRACE_DAYS=21
SUPERBASED_INITIAL_WORKSPACE_CREDITS=0
SUPERBASED_LOW_BALANCE_THRESHOLD_CREDITS=24
MGINX_URL=
MGINX_API_KEY=
SUPERBASED_CREDITS_PRODUCT_ID=
# Comma-separated checkout-required policy additions.
# Built-in defaults already include document and directory.
SUPERBASED_CHECKOUT_REQUIRED_RECORD_FAMILY_HASHES=
SUPERBASED_CHECKOUT_REQUIRED_FAMILY_SUFFIXES=
# Tower authenticates only explicitly allowlisted Nostr identities.
GIT_OIDC_ALLOWED_NPUBS=
GIT_GATEWAY_ORIGINS=
GIT_FORGEJO_BASE_URL=
GIT_GATEWAY_PORT=3180
GIT_GATEWAY_BROWSER_ORIGIN=https://forgejo.example.com
GIT_OIDC_ISSUER=https://tower.example.com/api/v4/git/oidc
GIT_OIDC_CLIENT_ID=forgejo
GIT_OIDC_CLIENT_SECRET=
GIT_OIDC_SIGNING_KEY=
GIT_OIDC_REDIRECT_URI=https://forgejo.example.com/user/oauth2/tower/callback
GIT_FORGEJO_OIDC_ACCOUNT_LINKING=disabled
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_ENDPOINT_PUBLIC=http://127.0.0.1:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=replace-with-local-access-key
STORAGE_S3_SECRET_KEY=replace-with-local-secret-key
STORAGE_S3_BUCKET=superbased-storage
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_UPLOAD_TTL_SECONDS=900
STORAGE_PRESIGN_DOWNLOAD_TTL_SECONDS=900
ADMIN_NPUB=npub1rwzv24nmzfjypx2a8m264ws9vht3uxp5vpypnluuzl67n4waq78suk0wul
FLIGHT_DECK_PG_APP_NPUB=npub1rwzv24nmzfjypx2a8m264ws9vht3uxp5vpypnluuzl67n4waq78suk0wul
FLIGHT_DECK_HOSTED_SIGNUP_SITE_NPUBS=npub1hd37reqgfcnz3pvzj4grknd2nkzc94p9ercmunrxx22razr2rfxsw6dns5
FLIGHT_DECK_HOSTED_SIGNUP_MAX_WORKSPACES=3
FLIGHT_DECK_HOSTED_SIGNUP_HOURLY_LIMIT=2
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=coworker_v4
DB_USER=postgres
DB_PASSWORD=replace-with-local-db-password
DB_MAX_CONNECTIONS=10
# WApp-to-Flight-Deck publishing v1 abuse and retention defaults.
WAPP_ACTIVITY_INSTALLATION_REQUESTS_PER_MINUTE=60
WAPP_ACTIVITY_INSTALLATION_BURST_REQUESTS=10
WAPP_ACTIVITY_INSTALLATION_BURST_WINDOW_SECONDS=10
WAPP_ACTIVITY_DESTINATION_REQUESTS_PER_MINUTE=30
WAPP_ACTIVITY_RESOLVED_HISTORY_DAYS=30
WAPP_ACTIVITY_PROJECTION_RETENTION_DAYS=90
WAPP_ACTIVITY_AUDIT_RETENTION_DAYS=365
WAPP_ACTIVITY_ACTIVE_MAX_AGE_DAYS=365
GRAPH_ENABLED=false
GRAPH_AGE_GRAPH_NAME=tower_memory
GRAPH_DB_HOST=127.0.0.1
GRAPH_DB_PORT=5432
GRAPH_DB_NAME=tower_graph
GRAPH_DB_ADMIN_USER=postgres
GRAPH_DB_ADMIN_PASSWORD=replace-with-local-graph-admin-password
GRAPH_DB_APP_USER=tower_graph_app
GRAPH_DB_APP_PASSWORD=replace-with-local-graph-app-password
GRAPH_DB_MAX_CONNECTIONS=10
GRAPH_ALLOWED_NPUBS=
LEARNING_CURATOR_NPUBS=

# USD hosted billing v1: local account/runner works without Stripe.
# Keep provider credentials server-only. Live Stripe rollout is blocked.
HOSTING_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact checkout return URLs, comma-separated (no wildcard origins).
HOSTING_STRIPE_RETURN_URLS=
# Optional scoped response evidence; public actor npub only. Disable after diagnosis.
# Logs identity and returned family/scope/channel counts, never payloads/cursors.
TOWER_PG_SYNC_TRACE_NPUB=
# Push delivery (APNs). Unset = provider not ready: the inbox and registry still work, no alert is queued.
# The key is a secret: set APNS_AUTH_KEY_FILE to a mounted file path (never commit the .p8).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_AUTH_KEY_FILE=
# APNS_TOPIC=<primary app bundle id>
# APNS_CLIENT_APP_ID=ambulando
# APNS_EXTRA_TOPICS=bundle.id=client_app,other.bundle=other_app
# APNS_ENVIRONMENTS=sandbox,production
# NOTIF_PUBLIC_ORIGIN=https://tower.example.com
# NOTIF_ALERTS=on
# NOTIF_ALERT_POLL_MS=2000
