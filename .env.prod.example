TOWER_PORT=3100
# Loopback is safe for a same-host reverse proxy. Set a private interface or
# 0.0.0.0 only when your deployment network requires direct host exposure.
TOWER_HOST_BIND_ADDRESS=127.0.0.1
TOWER_HOST_PORT=3100
SUPERBASED_DIRECT_HTTPS_URL=https://tower.example.com
SUPERBASED_BILLING_MODE=disabled
SUPERBASED_BILLING_GRACE_DAYS=21
SUPERBASED_INITIAL_WORKSPACE_CREDITS=0
SUPERBASED_LOW_BALANCE_THRESHOLD_CREDITS=24
MGINX_URL=
MGINX_API_KEY=
SUPERBASED_CREDITS_PRODUCT_ID=

# Comma-separated checkout-required policy additions.
# Built-in defaults already include document and directory.
SUPERBASED_CHECKOUT_REQUIRED_RECORD_FAMILY_HASHES=
SUPERBASED_CHECKOUT_REQUIRED_FAMILY_SUFFIXES=

# Tower authenticates allowlisted Nostr identities only. Forgejo owns OAuth and permissions.
# Exact comma-separated public HTTPS origins accepted by Git clients. This is
# independent operator configuration; Tower never derives it from another URL.
GIT_GATEWAY_ORIGINS=
GIT_FORGEJO_BASE_URL=http://forgejo:3000
GIT_GATEWAY_PORT=3180
GIT_GATEWAY_HOST_BIND_ADDRESS=127.0.0.1
GIT_GATEWAY_HOST_PORT=3180
GIT_GATEWAY_BROWSER_ORIGIN=https://forgejo.example.com
GIT_OIDC_ALLOWED_NPUBS=
GIT_OIDC_ISSUER=https://tower.example.com/api/v4/git/oidc
GIT_OIDC_CLIENT_ID=forgejo
GIT_OIDC_CLIENT_SECRET=
GIT_OIDC_CLIENT_SECRET_FILE=/run/tower-git-secrets/git-oidc-client-secret
GIT_OIDC_SIGNING_KEY=
GIT_OIDC_SIGNING_KEY_FILE=/run/tower-git-secrets/git-oidc-signing-key.pem
GIT_OIDC_REDIRECT_URI=https://forgejo.example.com/user/oauth2/tower/callback
GIT_FORGEJO_OIDC_ACCOUNT_LINKING=disabled
TOWER_GIT_SECRETS_DIR=./.runtime/tower-git-secrets

# Admin browser identity allowed to use /table-viewer and /api/v4/admin/*
ADMIN_NPUB=npub1rwzv24nmzfjypx2a8m264ws9vht3uxp5vpypnluuzl67n4waq78suk0wul
FLIGHT_DECK_PG_APP_NPUB=npub1replace-with-flight-deck-app-npub
FLIGHT_DECK_HOSTED_SIGNUP_SITE_NPUBS=npub1hd37reqgfcnz3pvzj4grknd2nkzc94p9ercmunrxx22razr2rfxsw6dns5
FLIGHT_DECK_HOSTED_SIGNUP_MAX_WORKSPACES=3
FLIGHT_DECK_HOSTED_SIGNUP_HOURLY_LIMIT=2

# Service identity. Keep this stable in production.
SUPERBASED_SERVICE_NSEC=nsec1replace-me

# Optional derived identity values. If omitted, Tower derives them from SUPERBASED_SERVICE_NSEC.
# SUPERBASED_SERVICE_PUBKEY_HEX=
# SUPERBASED_SERVICE_NPUB=

# Public Nstack services. Origins are explicit and must be routed by the
# operator; Tower never derives them from Host/X-Forwarded-* headers.
# Optional root HTTPS Autopilot origin for authenticated agent discovery.
# Empty means no advertised Autopilot service; never infer an origin.
NSTACK_AUTOPILOT_PUBLIC_ORIGIN=
NSTACK_RELAY_ENABLED=true
NOSTR_RELAY_PUBLIC_ORIGIN=wss://relay.example.com
NOSTR_RELAY_HOST_BIND_ADDRESS=127.0.0.1
NOSTR_RELAY_HOST_PORT=7777
# Comma-separated hex pubkeys allowed to publish signed NIP-01 events.
NOSTR_RELAY_PUBLISH_PUBKEYS=replace-with-64-character-hex-pubkey

NSTACK_BLOSSOM_ENABLED=true
NSTACK_BLOSSOM_PUBLIC_ORIGIN=https://blossom.example.com
BLOSSOM_PUBLIC_DOMAIN=blossom.example.com
# Single 64-character hex pubkey allowed to upload, mirror and optimise media.
BLOSSOM_PUBLISH_PUBKEY=replace-with-64-character-hex-pubkey
BLOSSOM_HOST_BIND_ADDRESS=127.0.0.1
BLOSSOM_HOST_PORT=3002

# MinIO is host-accessible on loopback only by default. Set the bind address to
# a private interface only when another trusted machine must access presigned URLs.
MINIO_HOST_BIND_ADDRESS=127.0.0.1
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# S3 / MinIO used by Tower.
# Default assumes the bundled MinIO service in docker-compose.prod.yml.
# Override these if you intentionally point Tower at an external S3-compatible service.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_ENDPOINT_PUBLIC=http://127.0.0.1:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=replace-me
STORAGE_S3_SECRET_KEY=replace-me
STORAGE_S3_BUCKET=superbased-storage
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_UPLOAD_TTL_SECONDS=900
STORAGE_PRESIGN_DOWNLOAD_TTL_SECONDS=900

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=coworker_v4
DB_USER=postgres
DB_PASSWORD=change-me
DB_MAX_CONNECTIONS=10

# Optional graph memory Postgres / AGE database.
GRAPH_ENABLED=false
GRAPH_AGE_GRAPH_NAME=tower_memory
GRAPH_DB_HOST=graph-postgres
GRAPH_DB_PORT=5432
GRAPH_DB_NAME=tower_graph
GRAPH_DB_ADMIN_USER=postgres
GRAPH_DB_ADMIN_PASSWORD=change-me-too
GRAPH_DB_APP_USER=tower_graph_app
GRAPH_DB_APP_PASSWORD=change-me-graph-app
GRAPH_DB_MAX_CONNECTIONS=10
GRAPH_ALLOWED_NPUBS=

# Optional startup tuning
DB_WAIT_MAX_ATTEMPTS=40

# Optional origin for Tower's existing ACL-backed root hash retrieval only.
# This is not the full Blossom sidecar and should normally remain Tower's own
# origin. The complete sidecar uses NSTACK_BLOSSOM_PUBLIC_ORIGIN above.
# BLOSSOM_PUBLIC_ORIGIN=https://tower.example.com

# USD hosted billing v1: server-only optional Stripe test credentials.
# Live mode remains blocked pending refund/dispute handling and provider acceptance.
HOSTING_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HOSTING_STRIPE_RETURN_URLS=
